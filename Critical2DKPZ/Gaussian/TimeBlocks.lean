module

public import Critical2DKPZ.Gaussian.CoordinateConditioning
public import Critical2DKPZ.Gaussian.DisorderLaws
public import Critical2DKPZ.Definitions.DisorderPast

/-! Time-block sigma-fields describe the Gaussian disorder on bounded time intervals. -/

@[expose] public noncomputable section

open MeasureTheory ProbabilityTheory

namespace Critical2DKPZ.Gaussian

/-- The space-time indices in the time interval `(m,n]`. -/
def timeBlock (m n : ℕ) : Set (ℕ × Site) := {p | m < p.1 ∧ p.1 ≤ n}

/-- The sigma-field generated by all coordinates in `(m,n]`. -/
@[instance_reducible]
def disorderBlock (m n : ℕ) : MeasurableSpace Disorder :=
  coordinateSigma (fun _ : ℕ × Site => ℝ) (timeBlock m n)

/-- The disorder sigma-field on (0,n] equals the past sigma-field at time n. -/
theorem disorderBlock_zero (n : ℕ) : disorderBlock 0 n = disorderPast n := rfl

/-- Block sigma-fields are sub-sigma-fields of the original product sigma-field. -/
theorem disorderBlock_le (m n : ℕ) :
    disorderBlock m n ≤ (inferInstance : MeasurableSpace Disorder) :=
  coordinateSigma_le _ _

/-- Enlarging the time interval enlarges its sigma-field. -/
theorem disorderBlock_mono {m n a b : ℕ} (ham : a ≤ m) (hnb : n ≤ b) :
    disorderBlock m n ≤ disorderBlock a b :=
  coordinateSigma_mono _ (fun _ hp => ⟨lt_of_le_of_lt ham hp.1, hp.2.trans hnb⟩)

/-- The sigma-fields of disjoint time blocks are independent. -/
theorem indep_disorderBlock {m n a b : ℕ}
    (h : Disjoint (Set.Ioc m n) (Set.Ioc a b)) :
    Indep (disorderBlock m n) (disorderBlock a b) disorderLaw := by
  have hblock : Disjoint (timeBlock m n) (timeBlock a b) :=
    h.preimage Prod.fst
  exact (IndepFun_iff_Indep _ _ _).mp (indepFun_restrict_infinitePi
    (fun _ : ℕ × Site => gaussianReal 0 1) (timeBlock m n) (timeBlock a b) hblock)

/-- In particular successive, nonoverlapping time blocks are independent. -/
theorem indep_disorderBlock_of_le {m n a b : ℕ} (hna : n ≤ a) :
    Indep (disorderBlock m n) (disorderBlock a b) disorderLaw := by
  apply indep_disorderBlock
  exact Set.disjoint_left.mpr fun _ hx hy => (not_lt_of_ge (hx.2.trans hna)) hy.1

/-- Joint independence for an arbitrary family of disjoint time intervals. -/
theorem iIndep_disorderBlock {K : Type*} (m n : K → ℕ)
    (h : Pairwise (fun i j => Disjoint (Set.Ioc (m i) (n i)) (Set.Ioc (m j) (n j)))) :
    iIndep (fun k => disorderBlock (m k) (n k)) disorderLaw :=
  iIndep_coordinateSigma (fun _ : ℕ × Site => gaussianReal 0 1)
    (fun k => timeBlock (m k) (n k)) (fun _ _ hij => (h hij).preimage Prod.fst)

/-- Conditioning on a time block integrates out all other disorder coordinates. -/
theorem condExp_disorderBlock_ae_eq (m n : ℕ) {X : Disorder → ℝ}
    (hXm : Measurable X) (hX : Integrable X disorderLaw) :
    disorderLaw[X | disorderBlock m n] =ᵐ[disorderLaw]
      fun ω => ∫ η, X (resample (timeBlock m n) ω η) ∂disorderLaw :=
  condExp_coordinateSigma_ae_eq (fun _ : ℕ × Site => gaussianReal 0 1) _ hXm hX

end Critical2DKPZ.Gaussian

end
