namespace Critical2DKPZ.LocalSobolev


/-- The test-evaluation readout of a finite tuple of local Sobolev carriers. -/
def locNegSobolevCarrierTupleTestReadout {s : ℝ} {k : ℕ}
    (T : Fin k → Analysis.Sobolev.LocNegSobolevCarrier s) :
    (Fin k × TestFn) → ℝ := fun p => (T p.1).1.toDistr p.2

/-- Test evaluations are continuous jointly over the finite tuple of carriers. -/
theorem continuous_locNegSobolevCarrierTupleTestReadout (s : ℝ) {k : ℕ} :
    Continuous (locNegSobolevCarrierTupleTestReadout (s := s) (k := k)) := by
  apply continuous_pi
  intro p
  exact (Analysis.Sobolev.continuous_locNegSobolevCarrier_testEvaluation s p.2).comp
    (continuous_apply p.1)

/-- The Borel structure of the finite carrier product is generated by all its test evaluations. -/
theorem measurableSpace_locNegSobolevCarrierTuple_eq_comap_testReadout
    (s : ℝ) [Fact (0 ≤ s)] {k : ℕ} :
    (inferInstance : MeasurableSpace
      (Fin k → Analysis.Sobolev.LocNegSobolevCarrier s)) =
      MeasurableSpace.comap
        (locNegSobolevCarrierTupleTestReadout (s := s) (k := k))
        (MeasurableSpace.pi : MeasurableSpace ((Fin k × TestFn) → ℝ)) := by
  let F := locNegSobolevCarrierTupleTestReadout (s := s) (k := k)
  let carrierReadout := Analysis.Sobolev.locNegSobolevCarrierTestReadout s
  have hcarrier := Analysis.Sobolev.measurableSpace_locNegSobolevCarrier_eq_comap_testReadout s
  have hcarrierReadoutMeas : @Measurable
      (Analysis.Sobolev.LocNegSobolevCarrier s) (TestFn → ℝ)
      (inferInstance : MeasurableSpace (Analysis.Sobolev.LocNegSobolevCarrier s))
      (MeasurableSpace.pi : MeasurableSpace (TestFn → ℝ)) carrierReadout := by
    apply measurable_iff_comap_le.mpr
    simpa only [carrierReadout] using le_of_eq hcarrier.symm
  have hF : Measurable F := by
    apply measurable_pi_iff.mpr
    intro p
    exact (measurable_pi_iff.mp hcarrierReadoutMeas) p.2 |>.comp
      (measurable_pi_apply p.1)
  apply le_antisymm
  · rw [MeasurableSpace.pi_eq_generateFrom_projections]
    apply MeasurableSpace.generateFrom_le
    rintro A ⟨i, U, hU, rfl⟩
    have hUread : @MeasurableSet (Analysis.Sobolev.LocNegSobolevCarrier s)
        (MeasurableSpace.comap carrierReadout
          (MeasurableSpace.pi : MeasurableSpace (TestFn → ℝ))) U :=
      hcarrier ▸ hU
    obtain ⟨B, hB, hEq⟩ : ∃ B : Set (TestFn → ℝ),
        @MeasurableSet (TestFn → ℝ)
          (MeasurableSpace.pi : MeasurableSpace (TestFn → ℝ)) B ∧
          carrierReadout ⁻¹' B = U :=
      MeasurableSpace.measurableSet_comap.mp hUread
    let g : ((Fin k × TestFn) → ℝ) → (TestFn → ℝ) := fun z φ => z (i, φ)
    have hg : Measurable g := by
      apply measurable_pi_iff.mpr
      intro φ
      exact (measurable_pi_iff.mp measurable_id) (i, φ)
    apply MeasurableSpace.measurableSet_comap.mpr
    refine ⟨g ⁻¹' B, hg hB, ?_⟩
    ext x
    change Analysis.Sobolev.locNegSobolevCarrierTestReadout s (x i) ∈ B ↔ x i ∈ U
    rw [← hEq]
    rfl
  · simpa only [F] using hF.comap_le

/-- The one-test-per-coordinate convergence implies convergence of every finite family of
test evaluations, by linearity and the finite-dimensional Cramér–Wold theorem. -/
private theorem tendstoInDistribution_finiteTestReadout_of_htest
    {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    (P : Measure Ω) [IsProbabilityMeasure P] (Q : ℕ → Measure Ω')
    [∀ N, IsProbabilityMeasure (Q N)] {k : ℕ}
    (F : ℕ → Ω' → Fin k → Distr) (G : Ω → Fin k → Distr)
    (hmeas : ∀ N i (φ : TestFn), Measurable fun ω => F N ω i φ)
    (hGmeas : ∀ i (φ : TestFn), Measurable fun ω => G ω i φ)
    (htest : ∀ φ : Fin k → TestFn,
      TendstoInDistribution (fun N ω i => F N ω i (φ i)) atTop
        (fun ω i => G ω i (φ i)) Q P)
    (S : Finset (Fin k × TestFn)) :
    TendstoInDistribution
      (fun (N : ℕ) (ω : Ω') (p : {p : Fin k × TestFn // p ∈ S}) =>
        F N ω p.1.1 p.1.2) atTop
      (fun (ω : Ω) (p : {p : Fin k × TestFn // p ∈ S}) => G ω p.1.1 p.1.2) Q P := by
  classical
  let σ : Type := {p : Fin k × TestFn // p ∈ S}
  letI instFintypeSigma : Fintype σ := Fintype.ofFinset S (fun _ => Iff.rfl)
  let e : EuclideanSpace ℝ σ ≃L[ℝ] (σ → ℝ) := EuclideanSpace.equiv σ ℝ
  let Xraw : ℕ → Ω' → σ → ℝ := fun (N : ℕ) (ω : Ω') (p : σ) =>
    F N ω p.1.1 p.1.2
  let Yraw : Ω → σ → ℝ := fun (ω : Ω) (p : σ) => G ω p.1.1 p.1.2
  let X : ℕ → Ω' → EuclideanSpace ℝ σ := fun N ω => e.symm (Xraw N ω)
  let Y : Ω → EuclideanSpace ℝ σ := fun ω => e.symm (Yraw ω)
  have hXrawmeas (N : ℕ) : Measurable (Xraw N) := by
    apply measurable_pi_iff.mpr
    intro p
    exact hmeas N p.1.1 p.1.2
  have hYrawmeas : Measurable Yraw := by
    apply measurable_pi_iff.mpr
    intro p
    exact hGmeas p.1.1 p.1.2
  have hX : ∀ N, AEMeasurable (X N) (Q N) := by
    intro N
    exact (e.symm.continuous.measurable.comp (hXrawmeas N)).aemeasurable
  have hY : AEMeasurable Y P :=
    (e.symm.continuous.measurable.comp hYrawmeas).aemeasurable
  have hEuclid : TendstoInDistribution X atTop Y Q P := by
    apply TendstoInDistribution.of_tendsto_charFun hX hY
    intro t
    let t' : σ → ℝ := e t
    let ψ : Fin k → TestFn := fun i =>
      ∑ p, if p.1.1 = i then t' p • p.1.2 else 0
    have hEval (N : ℕ) (ω : Ω') (i : Fin k) :
        F N ω i (ψ i) =
          ∑ p, if p.1.1 = i then t' p * F N ω p.1.1 p.1.2 else 0 := by
      simp only [ψ, map_sum]
      apply Finset.sum_congr rfl
      intro p hp
      by_cases hpi : p.1.1 = i <;> simp [hpi, smul_eq_mul]
    have hEvalG (ω : Ω) (i : Fin k) :
        G ω i (ψ i) =
          ∑ p, if p.1.1 = i then t' p * G ω p.1.1 p.1.2 else 0 := by
      simp only [ψ, map_sum]
      apply Finset.sum_congr rfl
      intro p hp
      by_cases hpi : p.1.1 = i <;> simp [hpi, smul_eq_mul]
    have hsum (N : ℕ) (ω : Ω') :
        (∑ i, F N ω i (ψ i)) = inner ℝ (X N ω) t := by
      rw [PiLp.inner_apply]
      simp only [Real.inner_apply]
      change (∑ i, F N ω i (ψ i)) = ∑ p, Xraw N ω p * t' p
      simp_rw [hEval]
      rw [Finset.sum_comm]
      simp only [Finset.sum_ite_eq, Finset.mem_univ, ite_true]
      apply Finset.sum_congr rfl
      intro p hp
      exact mul_comm _ _
    have hsumG (ω : Ω) :
        (∑ i, G ω i (ψ i)) = inner ℝ (Y ω) t := by
      rw [PiLp.inner_apply]
      simp only [Real.inner_apply]
      change (∑ i, G ω i (ψ i)) = ∑ p, Yraw ω p * t' p
      simp_rw [hEvalG]
      rw [Finset.sum_comm]
      simp only [Finset.sum_ite_eq, Finset.mem_univ, ite_true]
      apply Finset.sum_congr rfl
      intro p hp
      exact mul_comm _ _
    have hsumContinuous : Continuous (fun x : Fin k → ℝ => ∑ i, x i) := by
      fun_prop
    have hprojection : TendstoInDistribution
        (fun N ω => inner ℝ (X N ω) t) atTop
        (fun ω => inner ℝ (Y ω) t) Q P := by
      simpa [Function.comp_def, hsum, hsumG] using
        (htest ψ).continuous_comp hsumContinuous
    rw [charFun_map_eq_charFun_map_inner_one hY]
    have hprojectionCharFun := hprojection.tendsto_charFun (1 : ℝ)
    apply hprojectionCharFun.congr
    intro N
    rw [charFun_map_eq_charFun_map_inner_one (hX N)]
  have hraw := hEuclid.continuous_comp e.continuous
  have hsource (N : ℕ) : (fun ω => e (X N ω)) = Xraw N := by
    funext ω
    change e (e.symm (Xraw N ω)) = Xraw N ω
    exact e.apply_symm_apply _
  have hlimit : (fun ω => e (Y ω)) = Yraw := by
    funext ω
    change e (e.symm (Yraw ω)) = Yraw ω
    exact e.apply_symm_apply _
  exact hraw.congr
    (fun N => Filter.Eventually.of_forall fun ω => congrFun (hsource N) ω)
    (Filter.Eventually.of_forall fun ω => congrFun hlimit ω)

/-- The tuple conclusion from tightness of the carrier-valued tuple laws. -/
private theorem tendstoInDistribution_locNegSobolevTuple_of_tight
    {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    (P : Measure Ω) [IsProbabilityMeasure P] (Q : ℕ → Measure Ω')
    [∀ N, IsProbabilityMeasure (Q N)] {s : ℝ} (hs : 0 < s) {k : ℕ}
    (F : ℕ → Ω' → Fin k → Distr) (G : Ω → Fin k → Distr)
    (hmeas : ∀ N i (φ : TestFn), Measurable fun ω => F N ω i φ)
    (hGmeas : ∀ i (φ : TestFn), Measurable fun ω => G ω i φ)
    (hF : ∀ N ω i, MemLocalNegSobolev s (F N ω i))
    (hG : ∀ᵐ ω ∂P, ∀ i, MemLocalNegSobolev s (G ω i))
    (htest : ∀ φ : Fin k → TestFn,
      TendstoInDistribution (fun N ω i => F N ω i (φ i)) atTop
        (fun ω i => G ω i (φ i)) Q P)
    (hTight : IsTightMeasureSet (Set.range fun N : ℕ =>
      Measure.map (fun ω => fun i => (⟨F N ω i, hF N ω i⟩ :
        Analysis.Sobolev.LocNegSobolevCarrier s)) (Q N))) :
    TendstoInDistribution (fun N ω => toLocNegSobolevTuple s (F N ω)) atTop
      (fun ω => toLocNegSobolevTuple s (G ω)) Q P := by
  classical
  letI : Fact (0 ≤ s) := ⟨hs.le⟩
  let Carrier := Analysis.Sobolev.LocNegSobolevCarrier s
  letI : PseudoMetrizableSpace Carrier :=
    (Analysis.Sobolev.isInducing_locNegSobolevFourierReadout s hs.le).pseudoMetrizableSpace
  let CarrierTuple := Fin k → Carrier
  let X : ℕ → Ω' → CarrierTuple := fun N ω i => ⟨F N ω i, hF N ω i⟩
  obtain ⟨A, hA, hAmeas, hAsub⟩ := hG.exists_measurable_mem
  let G' : Ω → Fin k → Distr := fun ω i =>
    A.piecewise (fun ω => G ω i) (fun _ => 0) ω
  have hG'meas : ∀ i (φ : TestFn), Measurable fun ω => G' ω i φ := by
    intro i φ
    have hp : Measurable (A.piecewise (fun ω => G ω i φ) (fun _ => 0)) :=
      Measurable.piecewise hAmeas (hGmeas i φ) measurable_const
    have heq : (fun ω => G' ω i φ) = A.piecewise (fun ω => G ω i φ) (fun _ => 0) := by
      funext ω
      by_cases hω : ω ∈ A <;> simp [G', Set.piecewise, hω]
    exact heq ▸ hp
  have hG'mem : ∀ ω i, MemLocalNegSobolev s (G' ω i) := by
    intro ω i
    by_cases hω : ω ∈ A
    · simpa [G', hω] using hAsub ω hω i
    · simp [G', hω, memLocalNegSobolev_zero]
  let Y : Ω → CarrierTuple := fun ω i => ⟨G' ω i, hG'mem ω i⟩
  have hXmeas : ∀ N, Measurable (X N) := by
    intro N
    apply measurable_pi_iff.mpr
    intro i
    exact Analysis.Sobolev.measurable_locNegSobolevCarrier_of_testwise
      (fun ω => F N ω i) (fun φ => hmeas N i φ) (fun ω => hF N ω i)
  have hYmeas : Measurable Y := by
    apply measurable_pi_iff.mpr
    intro i
    exact Analysis.Sobolev.measurable_locNegSobolevCarrier_of_testwise
      (fun ω => G' ω i) (fun φ => hG'meas i φ) (fun ω => hG'mem ω i)
  have htest' : ∀ φ : Fin k → TestFn,
      TendstoInDistribution (fun N ω i => F N ω i (φ i)) atTop
        (fun ω i => G' ω i (φ i)) Q P := by
    intro φ
    have htarget : (fun ω i => G ω i (φ i)) =ᵐ[P]
        (fun ω i => G' ω i (φ i)) := by
      filter_upwards [hA] with ω hω
      funext i
      simp [G', hω]
    exact (htest φ).congr (fun _ => Filter.Eventually.of_forall fun _ => rfl) htarget
  have hCarrier : TendstoInDistribution X atTop Y Q P := by
    let R : CarrierTuple → (Fin k × TestFn) → ℝ :=
      locNegSobolevCarrierTupleTestReadout (s := s) (k := k)
    have hRcont : Continuous R := continuous_locNegSobolevCarrierTupleTestReadout s
    have hRmeas : Measurable R := by
      apply measurable_pi_iff.mpr
      intro p
      exact ((continuous_apply p).comp hRcont).measurable
    have hRreadout : (inferInstance : MeasurableSpace CarrierTuple) =
        MeasurableSpace.comap R
          (MeasurableSpace.pi : MeasurableSpace ((Fin k × TestFn) → ℝ)) := by
      exact measurableSpace_locNegSobolevCarrierTuple_eq_comap_testReadout
        (s := s) (k := k)
    let Pseq : ℕ → ProbabilityMeasure CarrierTuple := fun N =>
      ⟨Measure.map (X N) (Q N), inferInstance⟩
    let Plim : ProbabilityMeasure CarrierTuple := ⟨Measure.map Y P, inferInstance⟩
    have hread : ∀ S : Finset (Fin k × TestFn),
        Tendsto (fun N => (Pseq N).map
          (fun x => fun p : {p : Fin k × TestFn // p ∈ S} => R x p.1)) atTop
          (𝓝 (Plim.map (fun x => fun p : {p : Fin k × TestFn // p ∈ S} => R x p.1))) := by
      intro S
      have hfiniteF : TendstoInDistribution
          (fun (N : ℕ) (ω : Ω') (p : {p : Fin k × TestFn // p ∈ S}) =>
            F N ω p.1.1 p.1.2)
          atTop (fun (ω : Ω) (p : {p : Fin k × TestFn // p ∈ S}) => G' ω p.1.1 p.1.2) Q P := by
        exact tendstoInDistribution_finiteTestReadout_of_htest
          P Q F G' hmeas hG'meas htest' S
      have hfiniteCarrier : TendstoInDistribution
          (fun (N : ℕ) (ω : Ω') (p : {p : Fin k × TestFn // p ∈ S}) => R (X N ω) p.1)
          atTop (fun (ω : Ω) (p : {p : Fin k × TestFn // p ∈ S}) => R (Y ω) p.1) Q P := by
        apply hfiniteF.congr
          (fun N => Filter.Eventually.of_forall fun ω => by
            funext p
            change F N ω p.1.1 p.1.2 = (X N ω p.1.1).1.toDistr p.1.2
            rfl)
          (Filter.Eventually.of_forall fun ω => by
            funext p
            change G' ω p.1.1 p.1.2 = (Y ω p.1.1).1.toDistr p.1.2
            rfl)
      have hRfiniteMeas : Measurable
          (fun x : CarrierTuple => fun p : {p : Fin k × TestFn // p ∈ S} => R x p.1) := by
        apply measurable_pi_iff.mpr
        intro p
        exact (measurable_pi_iff.mp hRmeas) p.1
      have hmap (N : ℕ) :
          (Pseq N).map (fun x => fun p : {p : Fin k × TestFn // p ∈ S} => R x p.1) =
            ⟨Measure.map (fun ω p => R (X N ω) p.1) (Q N), inferInstance⟩ := by
        apply Subtype.ext
        change Measure.map (fun x => fun p : {p : Fin k × TestFn // p ∈ S} => R x p.1)
            (Measure.map (X N) (Q N)) = _
        rw [Measure.map_map hRfiniteMeas (hXmeas N)]
        rfl
      have hmapLim :
          Plim.map (fun x => fun p : {p : Fin k × TestFn // p ∈ S} => R x p.1) =
            ⟨Measure.map (fun ω p => R (Y ω) p.1) P, inferInstance⟩ := by
        apply Subtype.ext
        change Measure.map (fun x => fun p : {p : Fin k × TestFn // p ∈ S} => R x p.1)
            (Measure.map Y P) = _
        rw [Measure.map_map hRfiniteMeas hYmeas]
        rfl
      simpa only [hmap, hmapLim] using hfiniteCarrier.tendsto
    have hPseqTight : IsTightMeasureSet (Set.range fun N : ℕ =>
        (Pseq N : Measure CarrierTuple)) := by
      simpa [Pseq, X, Carrier, Analysis.Sobolev.LocNegSobolevCarrier] using hTight
    have hPM := Analysis.Sobolev.tendsto_probabilityMeasure_of_tight_finiteReadoutLaws
      R hRcont hRmeas hRreadout Pseq Plim hPseqTight hread
    exact ⟨fun N => (hXmeas N).aemeasurable, hYmeas.aemeasurable, by
      simpa [Pseq, Plim] using hPM⟩
  have hsource : ∀ N, (fun ω =>
      Analysis.Sobolev.locNegSobolevCarrierTupleToFrozen s (X N ω)) =ᵐ[Q N]
        (fun ω => toLocNegSobolevTuple s (F N ω)) := by
    intro N
    exact Filter.Eventually.of_forall fun ω => by
      funext i
      rfl
  have hlimit : (fun ω =>
      Analysis.Sobolev.locNegSobolevCarrierTupleToFrozen s (Y ω)) =ᵐ[P]
        (fun ω => toLocNegSobolevTuple s (G ω)) := by
    filter_upwards [hA] with ω hω
    funext i
    simp [Y, G', hω, Analysis.Sobolev.locNegSobolevCarrierTupleToFrozen,
      toLocNegSobolevTuple]
    rfl
  exact hCarrier.continuous_comp
    (Analysis.Sobolev.continuous_locNegSobolevCarrierTupleToFrozen s) |>.congr
      hsource hlimit

/-- Uniform expected order-`s/2` localizer energies make the carrier laws tight; finite
test-function convergence then gives convergence in distribution of the tuples. -/
theorem tendstoInDistribution_locNegSobolevTuple
    {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    (P : Measure Ω) [IsProbabilityMeasure P] (Q : ℕ → Measure Ω')
    [∀ N, IsProbabilityMeasure (Q N)] {s : ℝ} (hs : 0 < s) {k : ℕ}
    (F : ℕ → Ω' → Fin k → Distr) (G : Ω → Fin k → Distr)
    (hmeas : ∀ N i (φ : TestFn), Measurable fun ω => F N ω i φ)
    (hGmeas : ∀ i (φ : TestFn), Measurable fun ω => G ω i φ)
    (hF : ∀ N ω i, MemLocalNegSobolev s (F N ω i))
    (hG : ∀ᵐ ω ∂P, ∀ i, MemLocalNegSobolev s (G ω i))
    (hbound : ∀ i (χ : TestFn), ∃ C : ℝ, ∀ N,
      ∫⁻ ω, localNegSobolevSq (s / 2) (F N ω i) χ ∂(Q N) ≤ ENNReal.ofReal C)
    (htest : ∀ φ : Fin k → TestFn, TendstoInDistribution
      (fun N ω i => F N ω i (φ i)) atTop (fun ω i => G ω i (φ i)) Q P) :
    TendstoInDistribution (fun N ω => toLocNegSobolevTuple s (F N ω)) atTop
      (fun ω => toLocNegSobolevTuple s (G ω)) Q P := by
  classical
  letI : Fact (0 ≤ s) := ⟨hs.le⟩
  let Carrier := Analysis.Sobolev.LocNegSobolevCarrier s
  let CarrierTuple := Fin k → Carrier
  let X : ℕ → Ω' → CarrierTuple := fun N ω i => ⟨F N ω i, hF N ω i⟩
  have hXmeas : ∀ N, Measurable (X N) := by
    intro N
    apply measurable_pi_iff.mpr
    intro i
    exact Analysis.Sobolev.measurable_locNegSobolevCarrier_of_testwise
      (fun ω => F N ω i) (fun φ => hmeas N i φ) (fun ω => hF N ω i)
  let μ : ℕ → Measure CarrierTuple := fun N => Measure.map (X N) (Q N)
  have hμprob : ∀ N, IsProbabilityMeasure (μ N) := by
    intro N
    change IsProbabilityMeasure (Measure.map (X N) (Q N))
    exact (Measure.isProbabilityMeasure_map_iff (hXmeas N).aemeasurable).2 (inferInstance)
  letI : ∀ N, IsProbabilityMeasure (μ N) := hμprob
  have hE : ∀ (i : Fin k) (m : ℕ), ∃ M : ℝ≥0∞, M ≠ ⊤ ∧ ∀ N : ℕ,
      ∫⁻ x, localNegSobolevSq (s / 2) (x i).1.toDistr (localizer m) ∂(μ N) ≤ M := by
    intro i m
    obtain ⟨C, hC⟩ := hbound i (localizer m)
    refine ⟨ENNReal.ofReal C, ENNReal.ofReal_ne_top, fun N => ?_⟩
    have henergy : Measurable (fun x : CarrierTuple =>
        localNegSobolevSq (s / 2) (x i).1.toDistr (localizer m)) :=
      (Analysis.Sobolev.measurable_localEnergy_locNegSobolevCarrier s (s / 2)
        (localizer m)).comp (measurable_pi_apply i)
    calc
      ∫⁻ x, localNegSobolevSq (s / 2) (x i).1.toDistr (localizer m) ∂(μ N)
          = ∫⁻ ω, localNegSobolevSq (s / 2) ((X N ω) i).1.toDistr (localizer m) ∂(Q N) := by
            change ∫⁻ x, localNegSobolevSq (s / 2) (x i).1.toDistr (localizer m)
                ∂Measure.map (X N) (Q N) = _
            rw [lintegral_map henergy (hXmeas N)]
      _ ≤ ENNReal.ofReal C := by
        simpa [X, Carrier, Analysis.Sobolev.LocNegSobolevCarrier,
          Critical2DKPZ.LocNegSobolevTop.toDistr] using hC N
  have hTight : IsTightMeasureSet (Set.range fun N : ℕ =>
      Measure.map (fun ω => fun i => (⟨F N ω i, hF N ω i⟩ : Carrier)) (Q N)) := by
    have ht := Analysis.Sobolev.isTightMeasureSet_of_expected_localEnergy s hs μ hE
    simpa [μ, X, Carrier, CarrierTuple, Analysis.Sobolev.LocNegSobolevCarrier] using ht
  exact tendstoInDistribution_locNegSobolevTuple_of_tight P Q hs F G hmeas hGmeas
    hF hG htest hTight

