/-! On a locally compact second-countable Hausdorff space, a countable family of compact-test integrals generates the vague topology, whose Borel σ-algebra agrees with measure evaluation. -/

@[expose] public section

open MeasureTheory Filter Topology Set TopologicalSpace
open scoped CompactlySupported ENNReal

noncomputable section

set_option linter.style.haveILetI false

namespace Critical2DKPZ.RandomMeasure

/-- The sequence of integrals against the countable compact-test family associated with a compact exhaustion. -/
def countableVagueReadout {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
    [T2Space X] [LocallyCompactSpace X] [SecondCountableTopology X]
    (K : CompactExhaustion X) (μ : PositiveRadonMeasure X) :
    (ℕ × ℕ) ⊕ ℕ → ℝ := fun i => vaguePairing μ (countableVagueTest K i)

/-- The topology generated by the countable family of compact-test integrals. -/
@[instance_reducible]
def countableVagueTopology {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] (K : CompactExhaustion X) :
    TopologicalSpace (PositiveRadonMeasure X) :=
  TopologicalSpace.induced (countableVagueReadout K) inferInstance

/-- Every compactly supported continuous test integral is continuous in the topology generated by the countable test family. -/
theorem continuous_test_for_countableVagueTopology {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] (K : CompactExhaustion X)
    (f : C_c(X, ℝ)) :
    @Continuous (PositiveRadonMeasure X) ℝ (countableVagueTopology K) inferInstance
      (fun μ => vaguePairing μ f) := by
  letI : TopologicalSpace (PositiveRadonMeasure X) := countableVagueTopology K
  have hread : Continuous (countableVagueReadout K) := continuous_induced_dom
  have ht (i : (ℕ × ℕ) ⊕ ℕ) :
      Continuous (fun μ : PositiveRadonMeasure X =>
        vaguePairing μ (countableVagueTest K i)) := (continuous_apply i).comp hread
  rw [Metric.continuous_iff']
  intro μ ε hε
  obtain ⟨n, hsupport⟩ := exists_vagueExhaustionWindow_support K f
  let C : ℝ := |vaguePairing μ (vagueMassTest K n)| + 2
  have hC : 0 < C := by dsimp [C]; positivity
  let η : ℝ := ε / (3 * C)
  have hη : 0 < η := by dsimp [η]; positivity
  have hηC : η * C = ε / 3 := by dsimp [η]; field_simp
  obtain ⟨j, hj⟩ := exists_denseVagueTest_approx K n f hsupport η hη
  let g := denseVagueTest K n j
  have hgsupport : tsupport (g : X → ℝ) ⊆ K n := denseVagueTest_support K n j
  have hmass : ∀ᶠ ν in 𝓝 μ,
      dist (vaguePairing ν (vagueMassTest K n))
        (vaguePairing μ (vagueMassTest K n)) < 1 :=
    (Metric.continuousAt_iff'.mp (ht (.inr n)).continuousAt) 1 zero_lt_one
  have htest : ∀ᶠ ν in 𝓝 μ,
      dist (vaguePairing ν g) (vaguePairing μ g) < ε / 3 :=
    (Metric.continuousAt_iff'.mp (ht (.inl (n, j))).continuousAt)
      (ε / 3) (by positivity)
  filter_upwards [hmass, htest] with ν hmass htest
  change dist (vaguePairing ν (vagueMassTest K n))
    (vaguePairing μ (vagueMassTest K n)) < 1 at hmass
  change dist (vaguePairing ν g) (vaguePairing μ g) < ε / 3 at htest
  have hμmass : μ.measure.real (K n) ≤ C :=
    (vague_window_mass_le_test K μ n).trans (by
      dsimp [C, vaguePairing]
      linarith [le_abs_self (∫ x, vagueMassTest K n x ∂μ.measure)])
  have hνmass : ν.measure.real (K n) ≤ C :=
    (vague_window_mass_le_test K ν n).trans (by
      rw [Real.dist_eq] at hmass
      dsimp [vaguePairing] at hmass
      dsimp [C]
      have hupper :
          (∫ x, vagueMassTest K n x ∂ν.measure) ≤
            |(∫ x, vagueMassTest K n x ∂ν.measure) -
              ∫ x, vagueMassTest K n x ∂μ.measure| +
              |∫ x, vagueMassTest K n x ∂μ.measure| := by
        calc
          (∫ x, vagueMassTest K n x ∂ν.measure) =
              ((∫ x, vagueMassTest K n x ∂ν.measure) -
                ∫ x, vagueMassTest K n x ∂μ.measure) +
                ∫ x, vagueMassTest K n x ∂μ.measure := by ring
          _ ≤ _ := add_le_add (le_abs_self _) (le_abs_self _)
      calc
        (∫ x, vagueMassTest K n x ∂ν.measure) ≤
              |(∫ x, vagueMassTest K n x ∂ν.measure) -
              ∫ x, vagueMassTest K n x ∂μ.measure| +
              |∫ x, vagueMassTest K n x ∂μ.measure| := hupper
        _ = |∫ x, vagueMassTest K n x ∂μ.measure| +
              |(∫ x, vagueMassTest K n x ∂ν.measure) -
                ∫ x, vagueMassTest K n x ∂μ.measure| := by rw [add_comm]
        _ ≤ |∫ x, vagueMassTest K n x ∂μ.measure| + 1 :=
          add_le_add_right hmass.le _
        _ ≤ |∫ x, vagueMassTest K n x ∂μ.measure| + 2 := by linarith)
  have herr (ρ : PositiveRadonMeasure X) :
      |vaguePairing ρ f - vaguePairing ρ g| ≤
        η * ρ.measure.real (K n) := by
    exact vague_test_integral_error K ρ n f g hsupport hgsupport η
      (fun x hx => by simpa only [abs_sub_comm] using (hj x hx).le)
  have hνerr : |vaguePairing ν f - vaguePairing ν g| ≤ ε / 3 :=
    (herr ν).trans (by
      calc
        η * ν.measure.real (K n) ≤ η * C := mul_le_mul_of_nonneg_left hνmass hη.le
        _ = ε / 3 := hηC)
  have hμerr : |vaguePairing μ g - vaguePairing μ f| ≤ ε / 3 := by
    rw [abs_sub_comm]
    exact (herr μ).trans (by
      calc
        η * μ.measure.real (K n) ≤ η * C := mul_le_mul_of_nonneg_left hμmass hη.le
        _ = ε / 3 := hηC)
  have htri := abs_sub_le (vaguePairing ν f) (vaguePairing ν g) (vaguePairing μ f)
  have htri' := abs_sub_le (vaguePairing ν g) (vaguePairing μ g) (vaguePairing μ f)
  rw [Real.dist_eq] at htest ⊢
  linarith

/-- The countable test coordinates generate exactly the vague topology. -/
theorem countableVagueTopology_eq_vague {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] (K : CompactExhaustion X) :
    countableVagueTopology K = vagueTopology X := by
  have hfull : @Continuous (PositiveRadonMeasure X)
      (C_c(X, ℝ) → ℝ) (countableVagueTopology K) inferInstance
      (fun μ f => vaguePairing μ f) := by
    letI : TopologicalSpace (PositiveRadonMeasure X) := countableVagueTopology K
    exact continuous_pi fun f => continuous_test_for_countableVagueTopology K f
  have hcount : @Continuous (PositiveRadonMeasure X)
      ((ℕ × ℕ) ⊕ ℕ → ℝ) (vagueTopology X) inferInstance
      (countableVagueReadout K) := by
    exact continuous_pi fun i => continuous_vaguePairing (countableVagueTest K i)
  exact le_antisymm hfull.le_induced hcount.le_induced

/-- The vague topology on positive locally finite measures over a second-countable locally compact Hausdorff space is second-countable. -/
theorem vagueTopology_secondCountable {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] :
    @SecondCountableTopology (PositiveRadonMeasure X) (vagueTopology X) := by
  rw [← countableVagueTopology_eq_vague (vagueCompactExhaustion X)]
  exact secondCountableTopology_induced _ _ (countableVagueReadout (vagueCompactExhaustion X))

/-- The vague topology on positive Radon measures is second-countable. -/
instance instSecondCountableVagueTopology {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] :
    SecondCountableTopology (PositiveRadonMeasure X) :=
  vagueTopology_secondCountable

/-- Compact-test integrals are measurable with respect to the evaluation
sigma-algebra inherited from `Measure X`. -/
theorem measurable_vaguePairing_eval {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] (f : C_c(X, ℝ)) :
    @Measurable (PositiveRadonMeasure X) ℝ
      (MeasurableSpace.comap Subtype.val inferInstance) inferInstance
      (fun μ => vaguePairing μ f) := by
  have hp : @Measurable (PositiveRadonMeasure X) ℝ≥0∞
      (MeasurableSpace.comap Subtype.val inferInstance) inferInstance
      (fun μ => ∫⁻ x, ENNReal.ofReal (f x) ∂μ.measure) :=
    (Measure.measurable_lintegral f.continuous.measurable.ennreal_ofReal).comp
      measurable_subtype_coe
  have hn : @Measurable (PositiveRadonMeasure X) ℝ≥0∞
      (MeasurableSpace.comap Subtype.val inferInstance) inferInstance
      (fun μ => ∫⁻ x, ENNReal.ofReal (-f x) ∂μ.measure) :=
    (Measure.measurable_lintegral f.continuous.measurable.neg.ennreal_ofReal).comp
      measurable_subtype_coe
  have heq : (fun μ : PositiveRadonMeasure X => vaguePairing μ f) =
      fun μ => (∫⁻ x, ENNReal.ofReal (f x) ∂μ.measure).toReal -
        (∫⁻ x, ENNReal.ofReal (-f x) ∂μ.measure).toReal := by
    funext μ
    exact integral_eq_lintegral_pos_part_sub_lintegral_neg_part
      (integrable_vagueTest μ f)
  rw [heq]
  exact hp.ennreal_toReal.sub hn.ennreal_toReal

/-- The Borel sigma-algebra of the vague topology is contained in the
evaluation sigma-algebra on locally finite measures. -/
theorem vague_borel_le_eval {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] :
    @borel (PositiveRadonMeasure X) (vagueTopology X) ≤
      MeasurableSpace.comap Subtype.val inferInstance := by
  let K := vagueCompactExhaustion X
  rw [← countableVagueTopology_eq_vague K, countableVagueTopology, borel_comap]
  have hread : @Measurable (PositiveRadonMeasure X) ((ℕ × ℕ) ⊕ ℕ → ℝ)
      (MeasurableSpace.comap Subtype.val inferInstance) inferInstance
      (countableVagueReadout K) := by
    exact measurable_pi_iff.mpr fun i => measurable_vaguePairing_eval (countableVagueTest K i)
  simpa only [BorelSpace.measurable_eq] using hread.comap_le

/-- Positive compactly supported tests whose support lies inside an open set. -/
abbrev VagueOpenTest {X : Type*} [TopologicalSpace X] (U : Set X) :=
  {f : C_c(X, ℝ) // (∀ x, 0 ≤ f x) ∧ (∀ x, f x ≤ 1) ∧
    tsupport (f : X → ℝ) ⊆ U}

/-- Open-set mass is the supremum of the positive compactly supported test
integrals supported in that open set. -/
theorem vague_open_mass_eq_iSup_tests {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] (μ : PositiveRadonMeasure X)
    (U : Set X) (hU : IsOpen U) :
    μ.measure U = ⨆ f : VagueOpenTest U,
      ∫⁻ x, ENNReal.ofReal (f.val x) ∂μ.measure := by
  letI : IsLocallyFiniteMeasure μ.measure := μ.2
  have hregular : Measure.Regular μ.measure := by infer_instance
  letI : Measure.Regular μ.measure := hregular
  refine le_antisymm ?_ ?_
  · rw [hU.measure_eq_iSup_isCompact μ.measure]
    refine iSup_le fun K => iSup_le fun hKU => iSup_le fun hK => ?_
    obtain ⟨g, hgK, hgcompact, hgsupport, hg01⟩ :=
      exists_continuousMap_one_of_isCompact_subset_isOpen hK hU hKU
    let f : C_c(X, ℝ) := ⟨g, hgcompact⟩
    let φ : VagueOpenTest U :=
      ⟨f, (fun x => (hg01 x).1), (fun x => (hg01 x).2), hgsupport⟩
    have hKmeas : MeasurableSet K := hK.isClosed.measurableSet
    have hmass : μ.measure K ≤ ∫⁻ x, ENNReal.ofReal (f x) ∂μ.measure := by
      calc
        μ.measure K = ∫⁻ x, K.indicator (fun _ => (1 : ℝ≥0∞)) x ∂μ.measure := by
          rw [lintegral_indicator hKmeas]
          simp only [lintegral_const, one_mul, Measure.restrict_apply_univ]
        _ ≤ ∫⁻ x, ENNReal.ofReal (f x) ∂μ.measure := by
          apply lintegral_mono
          intro x
          by_cases hx : x ∈ K
          · rw [Set.indicator_of_mem hx]
            change (1 : ℝ≥0∞) ≤ ENNReal.ofReal (g x)
            rw [hgK hx]
            norm_num
          · rw [Set.indicator_of_notMem hx]
            exact bot_le
    exact hmass.trans (le_iSup_of_le φ le_rfl)
  · refine iSup_le fun f => ?_
    calc
      (∫⁻ x, ENNReal.ofReal (f.val x) ∂μ.measure) ≤
          ∫⁻ x, U.indicator (fun _ => (1 : ℝ≥0∞)) x ∂μ.measure := by
        apply lintegral_mono
        intro x
        by_cases hx : x ∈ U
        · rw [Set.indicator_of_mem hx]
          exact ENNReal.ofReal_le_one.mpr (f.property.2.1 x)
        · have hzero : f.val x = 0 := by
            by_contra hne
            exact hx (f.property.2.2 (subset_closure hne))
          simp [Set.indicator_of_notMem hx, hzero]
      _ = μ.measure U := by
        rw [lintegral_indicator hU.measurableSet]
        simp only [lintegral_const, one_mul, Measure.restrict_apply_univ]

/-- The supremum representation makes open-set mass lower semicontinuous in
the vague topology. -/
theorem lowerSemicontinuous_vague_open_mass {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] (U : Set X) (hU : IsOpen U) :
    LowerSemicontinuous (fun μ : PositiveRadonMeasure X => μ.measure U) := by
  have htest (f : VagueOpenTest U) :
      Continuous (fun μ : PositiveRadonMeasure X =>
        ∫⁻ x, ENNReal.ofReal (f.val x) ∂μ.measure) := by
    have heq : (fun μ : PositiveRadonMeasure X =>
        ∫⁻ x, ENNReal.ofReal (f.val x) ∂μ.measure) =
        fun μ => ENNReal.ofReal (vaguePairing μ f.val) := by
      funext μ
      exact (ofReal_integral_eq_lintegral_ofReal (integrable_vagueTest μ f.val)
        (ae_of_all _ fun x => f.property.1 x)).symm
    rw [heq]
    exact ENNReal.continuous_ofReal.comp (continuous_vaguePairing f.val)
  have hsup : LowerSemicontinuous (fun μ : PositiveRadonMeasure X =>
      ⨆ f : VagueOpenTest U, ∫⁻ x, ENNReal.ofReal (f.val x) ∂μ.measure) :=
    lowerSemicontinuous_iSup fun f => (htest f).lowerSemicontinuous
  have hrepr (μ : PositiveRadonMeasure X) :
      μ.measure U = ⨆ f : VagueOpenTest U,
        ∫⁻ x, ENNReal.ofReal (f.val x) ∂μ.measure :=
    vague_open_mass_eq_iSup_tests μ U hU
  convert hsup using 1
  funext μ
  exact hrepr μ

/-- Evaluation at an open set is Borel measurable for the vague Borel
structure. -/
theorem measurable_vague_open_mass {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] (U : Set X) (hU : IsOpen U) :
    @Measurable (PositiveRadonMeasure X) ℝ≥0∞
      (@borel _ (vagueTopology X)) inferInstance (fun μ => μ.measure U) := by
  letI : MeasurableSpace (PositiveRadonMeasure X) := @borel _ (vagueTopology X)
  letI : BorelSpace (PositiveRadonMeasure X) := ⟨rfl⟩
  exact (lowerSemicontinuous_vague_open_mass U hU).measurable

/-- The evaluation sigma-algebra restricted to locally finite measures is
contained in the vague Borel sigma-algebra. -/
theorem eval_le_vague_borel {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] :
    MeasurableSpace.comap Subtype.val inferInstance ≤
      @borel (PositiveRadonMeasure X) (vagueTopology X) := by
  letI : MeasurableSpace (PositiveRadonMeasure X) := @borel _ (vagueTopology X)
  let K := vagueCompactExhaustion X
  let W : ℕ → Set X := fun n => interior (K (n + 1))
  let ν : ℕ → PositiveRadonMeasure X → Measure X := fun n μ => μ.measure.restrict (W n)
  have hWopen (n : ℕ) : IsOpen (W n) := isOpen_interior
  have hWmono : Monotone W := by
    intro m n hmn
    exact interior_mono (K.subset (Nat.add_le_add_right hmn 1))
  have hWcover : ⋃ n, W n = univ := by
    apply iUnion_eq_univ_iff.2
    intro x
    obtain ⟨n, hn⟩ := K.exists_mem x
    refine ⟨n, ?_⟩
    simpa only [W] using K.subset_interior_succ n hn
  have hfinite (n : ℕ) (μ : PositiveRadonMeasure X) : IsFiniteMeasure (ν n μ) := by
    letI : IsLocallyFiniteMeasure μ.measure := μ.2
    change IsFiniteMeasure (μ.measure.restrict (W n))
    refine ⟨?_⟩
    rw [Measure.restrict_apply_univ]
    exact lt_of_le_of_lt (measure_mono (interior_subset : W n ⊆ K (n + 1)))
      (K.isCompact (n + 1)).measure_lt_top
  have hν (n : ℕ) : Measurable (ν n) := by
    letI (μ : PositiveRadonMeasure X) : IsFiniteMeasure (ν n μ) := hfinite n μ
    apply Measurable.measure_of_isPiSystem
      (BorelSpace.measurable_eq (α := X)) isPiSystem_isOpen
    · intro U hU
      change IsOpen U at hU
      simpa only [ν, Measure.restrict_apply hU.measurableSet] using
        measurable_vague_open_mass (U ∩ W n) (hU.inter (hWopen n))
    · change Measurable (fun μ : PositiveRadonMeasure X =>
        (μ.measure.restrict (W n)) univ)
      simpa only [ν, Measure.restrict_apply_univ] using
        measurable_vague_open_mass (W n) (hWopen n)
  have hval : @Measurable (PositiveRadonMeasure X) (Measure X)
      (@borel _ (vagueTopology X)) inferInstance Subtype.val := by
    apply Measure.measurable_of_measurable_coe
    intro A hA
    change Measurable (fun μ : PositiveRadonMeasure X => (μ : Measure X) A)
    have hmass (μ : PositiveRadonMeasure X) :
        (μ : Measure X) A = ⨆ n, ν n μ A := by
      have hmono : Monotone fun n => A ∩ W n :=
        fun i j hij => inter_subset_inter_right _ (hWmono hij)
      have hcoverA : (⋃ n, A ∩ W n) = A := by
        apply Subset.antisymm (iUnion_subset fun n => inter_subset_left) ?_
        intro x hx
        have hx' : x ∈ ⋃ n, W n := by rw [hWcover]; exact mem_univ x
        rcases mem_iUnion.mp hx' with ⟨n, hn⟩
        exact mem_iUnion.mpr ⟨n, hx, hn⟩
      calc
        μ.measure A = μ.measure (⋃ n, A ∩ W n) := by rw [hcoverA]
        _ = ⨆ n, μ.measure (A ∩ W n) := hmono.measure_iUnion
        _ = ⨆ n, ν n μ A := by
          congr 1
          funext n
          exact (Measure.restrict_apply hA).symm
    have hmassfun : (fun μ : PositiveRadonMeasure X => (μ : Measure X) A) =
        fun μ => ⨆ n, ν n μ A := by
      funext μ
      exact hmass μ
    rw [hmassfun]
    exact Measurable.iSup fun n => (Measure.measurable_coe hA).comp (hν n)
  exact hval.comap_le

/-- On locally finite measures, the inherited measure evaluation
sigma-algebra is exactly the Borel sigma-algebra of vague convergence. -/
theorem eval_eq_vague_borel {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] :
    MeasurableSpace.comap Subtype.val inferInstance =
      @borel (PositiveRadonMeasure X) (vagueTopology X) :=
  le_antisymm eval_le_vague_borel vague_borel_le_eval

/-- The Borel σ-algebra of vague convergence is generated by the countable compact-test integrals. -/
theorem vague_borel_eq_countableReadout {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] (K : CompactExhaustion X) :
    @borel (PositiveRadonMeasure X) (vagueTopology X) =
      MeasurableSpace.comap (countableVagueReadout K) inferInstance := by
  rw [← countableVagueTopology_eq_vague K, countableVagueTopology, borel_comap,
    ← (BorelSpace.measurable_eq (α := ((ℕ × ℕ) ⊕ ℕ → ℝ)))]

/-- The evaluation sigma-algebra on locally finite measures is the Borel
sigma-algebra of the vague topology. -/
instance instBorelSpacePositiveRadonMeasure {X : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] : BorelSpace (PositiveRadonMeasure X) :=
  ⟨eval_eq_vague_borel⟩

