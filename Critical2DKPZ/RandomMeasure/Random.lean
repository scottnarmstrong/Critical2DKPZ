module

public import Critical2DKPZ.RandomMeasure.GeneralBorel
import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic

/-! On a locally compact second-countable Hausdorff space, a random positive Radon measure is a measurable map into the vague Borel space, whose σ-algebra is generated by measure evaluations and countably many compact-test integrals. -/

public section

open MeasureTheory
open scoped CompactlySupported

set_option linter.style.haveILetI false

namespace Critical2DKPZ.RandomMeasure

/-- A measurable positive Radon-measure-valued random variable on a general
locally compact, second-countable Hausdorff space. -/
structure RandomRadonMeasure (Ω X : Type*) [MeasurableSpace Ω]
    [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [BorelSpace X] [T2Space X] [LocallyCompactSpace X]
    [SecondCountableTopology X] where
  value : Ω → PositiveRadonMeasure X
  measurable_value : @Measurable Ω (PositiveRadonMeasure X) inferInstance
    (@borel _ (vagueTopology X)) value

/-- The evaluation and vague Borel sigma-algebras agree, so measurability into
the vague Borel space is equivalent to evaluation measurability. -/
theorem measurable_radonMap_iff_evaluation {Ω X : Type*}
    [MeasurableSpace Ω] [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] [BorelSpace X] [T2Space X]
    [LocallyCompactSpace X] [SecondCountableTopology X]
    (F : Ω → PositiveRadonMeasure X) :
    @Measurable Ω (PositiveRadonMeasure X) inferInstance
        (@borel _ (vagueTopology X)) F ↔
      @Measurable Ω (PositiveRadonMeasure X) inferInstance
        (MeasurableSpace.comap Subtype.val inferInstance) F := by
  rw [eval_eq_vague_borel]


end Critical2DKPZ.RandomMeasure

end
