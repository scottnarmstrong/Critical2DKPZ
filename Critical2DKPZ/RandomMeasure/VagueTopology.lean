module

public import Critical2DKPZ.RandomMeasure.Carrier
public import Mathlib.MeasureTheory.Integral.CompactlySupported
import Mathlib.MeasureTheory.Measure.Regular

/-! On a locally compact Hausdorff space, the vague topology on positive locally finite Borel measures is generated by compactly supported continuous real test integrals. -/

public section

open MeasureTheory Filter
open scoped CompactlySupported Topology

noncomputable section

namespace Critical2DKPZ.RandomMeasure

/-- Pair a locally finite measure with a compactly supported continuous test. -/
@[expose]
def vaguePairing {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
    (μ : PositiveRadonMeasure X) (f : C_c(X, ℝ)) : ℝ :=
  ∫ x, f x ∂μ.measure

/-- The compactly supported vague test is integrable. -/
theorem integrable_vagueTest {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] [LocallyCompactSpace X] [T2Space X]
    (μ : PositiveRadonMeasure X)
    (f : C_c(X, ℝ)) : Integrable f μ.measure := by
  let _ : IsLocallyFiniteMeasure μ.measure := μ.2
  exact f.continuous.integrable_of_hasCompactSupport f.hasCompactSupport

/-- The topology generated by all compactly supported continuous test integrals. -/
@[expose, instance_reducible]
def vagueTopology (X : Type*) [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] [LocallyCompactSpace X] [T2Space X] :
    TopologicalSpace (PositiveRadonMeasure X) :=
  TopologicalSpace.induced (fun μ : PositiveRadonMeasure X => vaguePairing μ) inferInstance

instance instVagueTopology (X : Type*) [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] [LocallyCompactSpace X] [T2Space X] :
    TopologicalSpace (PositiveRadonMeasure X) := vagueTopology X

/-- The vague test pairing is continuous. -/
theorem continuous_vaguePairing {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] [LocallyCompactSpace X] [T2Space X] (f : C_c(X, ℝ)) :
    Continuous (fun μ : PositiveRadonMeasure X => vaguePairing μ f) := by
  have h : Continuous (fun μ : PositiveRadonMeasure X => fun g : C_c(X, ℝ) =>
      vaguePairing μ g) := continuous_induced_dom
  exact (continuous_apply f).comp h

/-- Vague convergence is equivalent to convergence of every compactly supported continuous test pairing. -/
theorem tendsto_vague_iff_forall_test {X : Type*} [TopologicalSpace X]
    [MeasurableSpace X] [OpensMeasurableSpace X] [LocallyCompactSpace X] [T2Space X]
    {ι : Type*} {l : Filter ι} (μ : ι → PositiveRadonMeasure X)
    (ν : PositiveRadonMeasure X) :
    Tendsto μ l (𝓝 ν) ↔ ∀ f : C_c(X, ℝ),
      Tendsto (fun i => vaguePairing (μ i) f) l (𝓝 (vaguePairing ν f)) := by
  change Tendsto μ l (@nhds _ (vagueTopology X) ν) ↔ _
  rw [vagueTopology, nhds_induced, Filter.tendsto_comap_iff, tendsto_pi_nhds]
  rfl

end Critical2DKPZ.RandomMeasure

end
