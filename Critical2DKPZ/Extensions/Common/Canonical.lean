module

public import Critical2DKPZ.Extensions.Common.Uniqueness
public import Critical2DKPZ.Definitions.IsCriticalSHF
public import Critical2DKPZ.Definitions.ShfSigma
import Critical2DKPZ.Provider.CriticalKPZMain

/-! # Canonical measurable versions of critical KPZ pairings

The main construction applies to every critical stochastic heat flow. Its measurable
version and convergence properties transfer to any associated critical KPZ field.
-/

@[expose] public section

open MeasureTheory Filter TopologicalSpace
open scoped BoundedContinuousFunction ENNReal

namespace Critical2DKPZ.Extensions.Common

/-- The sigma algebra generated by a critical SHF is contained in the ambient one. -/
theorem shfSigma_le (ϑ : ℝ) {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (Z : ℝ → ℝ → Ω → Measure (Plane × Plane))
    (hZ : IsCriticalSHF ϑ P Z) : shfSigma Z ≤ (inferInstance : MeasurableSpace Ω) := by
  dsimp [shfSigma]
  apply iSup_le
  intro s
  apply iSup_le
  intro t
  apply iSup_le
  intro hst
  exact (hZ.1 s t hst.1 hst.2).comap_le

/-- Every critical SHF admits a critical KPZ version measurable in that SHF. -/
theorem exists_canonical_criticalKPZ (ϑ : ℝ) {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (Z : ℝ → ℝ → Ω → Measure (Plane × Plane)) (hZ : IsCriticalSHF ϑ P Z) :
    ∃ H : ℝ → (Plane →ᵇ ℝ) → Ω → Distr, IsCriticalKPZ P Z H ∧
      ∀ t, 0 < t → ∀ (h₀ : Plane →ᵇ ℝ) (φ : TestFn),
        Measurable[shfSigma Z] (fun ω => H t h₀ ω φ) := by
  obtain ⟨H, hH, hm, _⟩ := Critical2DKPZ.Provider.criticalKPZ_main ϑ P Z hZ
  exact ⟨H, hH, hm⟩

/-- Each tested value of an arbitrary critical KPZ field has an SHF-measurable version. -/
theorem exists_shfSigma_measurable_pairing_of_isCriticalKPZ (ϑ : ℝ)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (Z : ℝ → ℝ → Ω → Measure (Plane × Plane)) (hZ : IsCriticalSHF ϑ P Z)
    (H : ℝ → (Plane →ᵇ ℝ) → Ω → Distr) (hH : IsCriticalKPZ P Z H)
    (t : ℝ) (ht : 0 < t) (h₀ : Plane →ᵇ ℝ) (φ : TestFn) :
    ∃ X : Ω → ℝ, Measurable[shfSigma Z] X ∧ (fun ω => H t h₀ ω φ) =ᵐ[P] X := by
  obtain ⟨H', hH', hm⟩ := exists_canonical_criticalKPZ ϑ P Z hZ
  exact ⟨fun ω => H' t h₀ ω φ, hm t ht h₀ φ,
    ae_eq_of_isCriticalKPZ P Z H H' hH hH' t ht h₀ φ⟩

/-- Tested values of any critical KPZ field are a.e. measurable. -/
theorem aemeasurable_pairing_of_isCriticalKPZ (ϑ : ℝ)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (Z : ℝ → ℝ → Ω → Measure (Plane × Plane)) (hZ : IsCriticalSHF ϑ P Z)
    (H : ℝ → (Plane →ᵇ ℝ) → Ω → Distr) (hH : IsCriticalKPZ P Z H)
    (t : ℝ) (ht : 0 < t) (h₀ : Plane →ᵇ ℝ) (φ : TestFn) :
    AEMeasurable (fun ω => H t h₀ ω φ) P := by
  obtain ⟨X, hm, heq⟩ :=
    exists_shfSigma_measurable_pairing_of_isCriticalKPZ ϑ P Z hZ H hH t ht h₀ φ
  exact ((hm.mono (shfSigma_le ϑ P Z hZ) le_rfl).aemeasurable).congr heq.symm

/-- Tested regularizations converge in every finite Lᵖ to any associated critical KPZ field. -/
theorem tendsto_eLpNorm_kpzRegularized_isCriticalKPZ (ϑ : ℝ)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (Z : ℝ → ℝ → Ω → Measure (Plane × Plane)) (hZ : IsCriticalSHF ϑ P Z)
    (H : ℝ → (Plane →ᵇ ℝ) → Ω → Distr) (hH : IsCriticalKPZ P Z H)
    (t : ℝ) (ht : 0 < t) (h₀ : Plane →ᵇ ℝ) (φ : TestFn)
    (p : ℝ≥0∞) (hp : 1 ≤ p) (hp_top : p ≠ ⊤) :
    Tendsto (fun δ => eLpNorm (fun ω =>
        (∫ x, φ x * kpzRegularized P Z t δ h₀ x ω) - H t h₀ ω φ) p P)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
  obtain ⟨H', hH', _, _, _, _, hlp, _⟩ :=
    Critical2DKPZ.Provider.criticalKPZ_main ϑ P Z hZ
  have heq := ae_eq_of_isCriticalKPZ P Z H H' hH hH' t ht h₀ φ
  have hnorm (δ : ℝ) :
      eLpNorm (fun ω => (∫ x, φ x * kpzRegularized P Z t δ h₀ x ω) - H t h₀ ω φ) p P =
      eLpNorm (fun ω => (∫ x, φ x * kpzRegularized P Z t δ h₀ x ω) - H' t h₀ ω φ) p P := by
    apply eLpNorm_congr_ae
    filter_upwards [heq] with ω hω
    rw [hω]
  simp_rw [hnorm]
  exact hlp t ht h₀ φ p hp hp_top

end Critical2DKPZ.Extensions.Common
