namespace Critical2DKPZ

/-- Transition probability `q_n(z) = P₀(S_n = z)` of the simple random walk. -/
def srwKernel (n : ℕ) (z : Site) : ℝ :=
  ∑ s : Fin n → Fin 4, (4 : ℝ)⁻¹ ^ n * if walkPosition 0 s n = z then 1 else 0

end Critical2DKPZ

