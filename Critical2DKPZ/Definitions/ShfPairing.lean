/-- `Z_{s,t}(f, g) = ∫ f(x) g(y) Z_{s,t}(dx, dy)` (§2.1). -/
def shfPairing {Ω : Type*} (Z : ℝ → ℝ → Ω → Measure (Plane × Plane)) (s t : ℝ)
    (f g : Plane → ℝ) (ω : Ω) : ℝ :=
  ∫ p, f p.1 * g p.2 ∂(Z s t ω)

end Critical2DKPZ

