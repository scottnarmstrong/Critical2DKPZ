module

public import Critical2DKPZ.Definitions.Plane
public import Mathlib.Topology.ContinuousMap.Algebra
public import Mathlib.LinearAlgebra.Span.Defs
import Mathlib.Topology.ContinuousMap.StoneWeierstrass

/-! # The separating algebra of continuous endpoint tensors

Products of continuous tests on the two endpoint planes span a unital
algebra which separates plane pairs. Stone-Weierstrass therefore approximates
any continuous plane-pair function uniformly on each compact set.
-/

@[expose] public noncomputable section

open Set

namespace Critical2DKPZ.SHF.Tsai

/-- A continuous endpoint tensor before imposing compact support. -/
def continuousTensorTest (g g' : C(Plane, ℝ)) : C(Plane × Plane, ℝ) :=
  ⟨fun p => g p.1 * g' p.2,
    (g.continuous.comp continuous_fst).mul (g'.continuous.comp continuous_snd)⟩

/-- The linear span of continuous endpoint tensors. -/
def continuousTensorSpan : Submodule ℝ C(Plane × Plane, ℝ) :=
  Submodule.span ℝ (Set.range (fun q : C(Plane, ℝ) × C(Plane, ℝ) => continuousTensorTest q.1 q.2))

/-- The tensor span contains the constant unit. -/
theorem one_mem_continuousTensorSpan : (1 : C(Plane × Plane, ℝ)) ∈ continuousTensorSpan := by
  apply Submodule.subset_span
  refine ⟨(1, 1), ?_⟩
  ext p
  simp [continuousTensorTest]

/-- The continuous tensor span is closed under multiplication. -/
theorem mul_mem_continuousTensorSpan {f g : C(Plane × Plane, ℝ)}
    (hf : f ∈ continuousTensorSpan) (hg : g ∈ continuousTensorSpan) :
    f * g ∈ continuousTensorSpan := by
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨⟨u, v⟩, rfl⟩ := hf
    induction hg using Submodule.span_induction with
    | mem g hg =>
      obtain ⟨⟨u', v'⟩, rfl⟩ := hg
      have heq : continuousTensorTest u v * continuousTensorTest u' v' =
          continuousTensorTest (u * u') (v * v') := by
        ext p
        simp only [continuousTensorTest, ContinuousMap.mul_apply, ContinuousMap.coe_mk]
        ring
      rw [heq]
      exact Submodule.subset_span ⟨(u * u', v * v'), rfl⟩
    | zero => simpa only [mul_zero] using continuousTensorSpan.zero_mem
    | add a b ha hb iha ihb =>
      rw [mul_add]
      exact continuousTensorSpan.add_mem iha ihb
    | smul c a ha iha =>
      rw [mul_smul_comm]
      exact continuousTensorSpan.smul_mem c iha
  | zero => simpa only [zero_mul] using continuousTensorSpan.zero_mem
  | add a b ha hb iha ihb =>
    rw [add_mul]
    exact continuousTensorSpan.add_mem iha ihb
  | smul c a ha iha =>
    rw [smul_mul_assoc]
    exact continuousTensorSpan.smul_mem c iha

/-- The unital algebra generated by the continuous endpoint tensors. -/
def continuousTensorAlgebra : Subalgebra ℝ C(Plane × Plane, ℝ) :=
  continuousTensorSpan.toSubalgebra one_mem_continuousTensorSpan
    (fun _ _ hf hg => mul_mem_continuousTensorSpan hf hg)

/-- Endpoint tensors separate distinct plane pairs. -/
theorem continuousTensorAlgebra_separatesPoints : continuousTensorAlgebra.SeparatesPoints := by
  intro x y hxy
  by_cases hx : x.1 = y.1
  · have hy : y.2 ≠ x.2 := by
      intro hy
      exact hxy (Prod.ext hx hy.symm)
    let g : C(Plane, ℝ) := ⟨fun z => dist z x.2, continuous_id.dist continuous_const⟩
    refine ⟨continuousTensorTest 1 g,
      ⟨continuousTensorTest 1 g,
        (show continuousTensorTest 1 g ∈ continuousTensorSpan from Submodule.subset_span ⟨(1, g), rfl⟩), rfl⟩, ?_⟩
    simpa only [continuousTensorTest, ContinuousMap.coe_mk, ContinuousMap.one_apply, one_mul,
      g, dist_self] using (ne_of_gt (dist_pos.mpr hy)).symm
  · have hne : y.1 ≠ x.1 := Ne.symm hx
    let g : C(Plane, ℝ) := ⟨fun z => dist z x.1, continuous_id.dist continuous_const⟩
    refine ⟨continuousTensorTest g 1,
      ⟨continuousTensorTest g 1,
        (show continuousTensorTest g 1 ∈ continuousTensorSpan from Submodule.subset_span ⟨(g, 1), rfl⟩), rfl⟩, ?_⟩
    simpa only [continuousTensorTest, ContinuousMap.coe_mk, ContinuousMap.one_apply, mul_one,
      g, dist_self] using (ne_of_gt (dist_pos.mpr hne)).symm

/-- Continuous endpoint tensor sums approximate arbitrary continuous tests on each compact set. -/
theorem exists_continuousTensorSpan_approx (f : C(Plane × Plane, ℝ))
    {K : Set (Plane × Plane)} (hK : IsCompact K) {ε : ℝ} (hε : 0 < ε) :
    ∃ g ∈ continuousTensorSpan, ∀ p ∈ K, |g p - f p| < ε := by
  obtain ⟨g, hg, happrox⟩ :=
    ContinuousMap.exists_mem_subalgebra_near_continuous_of_isCompact_of_separatesPoints
      continuousTensorAlgebra_separatesPoints f hK hε
  exact ⟨g, hg, fun p hp => by simpa only [Real.norm_eq_abs] using happrox p hp⟩

end Critical2DKPZ.SHF.Tsai

end
