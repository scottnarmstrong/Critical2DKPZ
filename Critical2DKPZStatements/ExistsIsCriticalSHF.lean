namespace Critical2DKPZ

/-- **Theorem A** (existence of the SHF, §1.1): for every `ϑ`, a critical 2D SHF exists. -/
theorem exists_isCriticalSHF (ϑ : ℝ) :
    ∃ (Ω : Type) (_ : MeasurableSpace Ω) (P : Measure Ω) (_ : IsProbabilityMeasure P)
      (Z : ℝ → ℝ → Ω → Measure (Plane × Plane)), IsCriticalSHF ϑ P Z :=
  by exact Critical2DKPZ.Provider.exists_isCriticalSHF ϑ
end Critical2DKPZ

